{
  "info": {
    "_postman_id": "admission-lead-api-collection-v1",
    "name": "NMC - Admission Application Leads APIs",
    "description": "Postman Collection for Admission Application Form Submission (Public) and Admin Lead Management.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Submit Admission Application (Public Form)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"full_name\": \"Aakash Varma\",\n  \"mobile\": \"9876543210\",\n  \"email\": \"aakash.varma@example.com\",\n  \"dob\": \"2002-05-15\",\n  \"gender\": \"Male\",\n  \"city_village\": \"Bhavnagar\",\n  \"course\": \"B.Sc. Nursing\",\n  \"last_qualification\": \"12th Science (PCB)\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/admission/submit",
          "host": ["{{base_url}}"],
          "path": ["api", "admission", "submit"]
        },
        "description": "Public endpoint for website visitors/students to submit admission application form."
      },
      "response": []
    },
    {
      "name": "2. Get Admission Leads List (Super Admin & Department Only)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{jwt_token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/admission?page=1&limit=10&status=all&course=all&search=",
          "host": ["{{base_url}}"],
          "path": ["api", "admission"],
          "query": [
            {
              "key": "page",
              "value": "1"
            },
            {
              "key": "limit",
              "value": "10"
            },
            {
              "key": "status",
              "value": "all",
              "description": "pending | in_progress | contacted | enrolled | rejected | closed | all"
            },
            {
              "key": "course",
              "value": "all"
            },
            {
              "key": "search",
              "value": "",
              "description": "Search by student name, mobile, email, city, course, or qualification"
            }
          ]
        },
        "description": "Fetches admission applications list. Blocked for Content role."
      },
      "response": []
    },
    {
      "name": "3. Get Single Admission Lead by ID",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{jwt_token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/admission/{{admission_lead_id}}",
          "host": ["{{base_url}}"],
          "path": ["api", "admission", "{{admission_lead_id}}"]
        },
        "description": "Get single admission application details."
      },
      "response": []
    },
    {
      "name": "4. Update Admission Lead Status (Super Admin & Department Only)",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{jwt_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"enrolled\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/admission/{{admission_lead_id}}",
          "host": ["{{base_url}}"],
          "path": ["api", "admission", "{{admission_lead_id}}"]
        },
        "description": "Update application status to pending, in_progress, contacted, enrolled, rejected, or closed."
      },
      "response": []
    },
    {
      "name": "5. Delete Admission Lead (Soft Delete - Super Admin Only)",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{jwt_token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/admission/{{admission_lead_id}}",
          "host": ["{{base_url}}"],
          "path": ["api", "admission", "{{admission_lead_id}}"]
        },
        "description": "Soft deletes admission lead record."
      },
      "response": []
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:5000"
    },
    {
      "key": "jwt_token",
      "value": "PASTE_YOUR_JWT_TOKEN_HERE"
    },
    {
      "key": "admission_lead_id",
      "value": "66d35..."
    }
  ]
}
