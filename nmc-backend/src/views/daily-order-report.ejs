<!DOCTYPE html>
<html>

<head>
    <meta charset="utf-8" />
    <title>Daily Order Report</title>
    <style>
        .report-box {
            max-width: 1000px;
            margin: auto;
            padding: 30px;
            border: 1px solid #eee;
            box-shadow: 0 0 10px rgba(0, 0, 0, 0.15);
            font-size: 14px;
            line-height: 24px;
            font-family: 'Helvetica Neue', 'Helvetica', Helvetica, Arial, sans-serif;
            color: #555;
        }

        .report-box table {
            width: 100%;
            line-height: inherit;
            text-align: left;
            border-collapse: collapse;
        }

        .report-box table th,
        .report-box table td {
            padding: 10px;
            border: 1px solid #ddd;
            vertical-align: top;
        }

        .report-box table th {
            background: #f4f4f4;
            font-weight: bold;
            text-align: center;
        }

        .report-box table td {
             text-align: center;
        }
        
        .report-box table td.text-left {
            text-align: left;
        }

        .report-box .title {
            font-size: 24px;
            font-weight: bold;
            color: #333;
            margin-bottom: 20px;
            text-align: center;
        }
        
        .status-completed {
            color: #10b981;
            font-weight: bold;
        }

        .status-confirmed {
             color: #3b82f6;
             font-weight: bold;
        }

        .invoice-icon {
            text-decoration: none;
            font-size: 20px;
        }
    </style>
</head>

<body>
    <div class="report-box">
        <div class="title">RunrKids Order Report - <%= date %></div>
        
        <table>
            <thead>
                <tr>
                    <th style="width: 50px;">Sr. No.</th>
                    <th>User Name</th>
                    <th>Order Offer Total</th>
                    <th>Order Tax</th>
                    <th>Order Discount</th>
                    <th>Order Total</th>
                    <th>Status</th>
                    <th>Payment Method</th>
                    <th>Invoice</th>
                </tr>
            </thead>
            <tbody>
                <% if (orders && orders.length > 0) { %>
                    <% orders.forEach((order, index) => { %>
                        <tr>
                            <td><%= index + 1 %></td>
                            <td class="text-left"><%= order.user_name %></td>
                            <td>₹<%= parseFloat(order.order_offer_total).toFixed(2) %></td>
                            <td>₹<%= parseFloat(order.order_tax).toFixed(2) %></td>
                            <td>-₹<%= parseFloat(order.order_discount).toFixed(2) %></td>
                            <td><b>₹<%= parseFloat(order.order_total).toFixed(2) %></b></td>
                            <td>
                                <% if (order.order_status === 1) { %>
                                    <span class="status-completed">Completed</span>
                                <% } else if (order.order_status === 2) { %>
                                    <span class="status-confirmed">Confirmed</span>
                                <% } else { %>
                                    <%= order.order_status %>
                                <% } %>
                            </td>
                            <td style="text-transform: capitalize;"><%= order.payment_method %></td>
                            <td>
                                <% if (order.invoice_path) { %>
                                    <a href="<%= order.invoice_url %>" target="_blank" class="invoice-icon" title="View Invoice">📄</a>
                                <% } else { %>
                                    -
                                <% } %>
                            </td>
                        </tr>
                    <% }) %>
                    
                    <!-- Grand Total Row -->
                     <tr>
                        <td colspan="5" style="text-align: right; font-weight: bold;">Total Revenue:</td>
                        <td style="font-weight: bold;">₹<%= totalRevenue.toFixed(2) %></td>
                        <td colspan="3"></td>
                    </tr>
                <% } else { %>
                    <tr>
                        <td colspan="9" style="text-align: center;">No orders found for today.</td>
                    </tr>
                <% } %>
            </tbody>
        </table>
        
        <p style="text-align: center; margin-top: 30px; font-size: 12px; color: #999;">
            Auto-generated report by RunrKids System
        </p>
    </div>
</body>

</html>
