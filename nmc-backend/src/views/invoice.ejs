<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>General Invoice - Runr Kids</title>

    <meta name="author" content="author invoice">

    <style>
        body {
            font-family: 'Montserrat', sans-serif;
        }

        .invoice-box {
            max-width: 890px;
            margin: auto;
            padding: 10px;
            border: 1px solid #eee;
            font-size: 10px;
            line-height: 24px;
            color: #555;
        }

        .top_rw {
            background-color: #f4f4f4;
        }

        table {
            width: 100%;
            text-align: left;
            border-bottom: solid 1px #ccc;
            border-collapse: unset;
        }

        table td {
            font-size: 12px;
            padding: 5px;
            vertical-align: middle;
        }

        table tr td:nth-child(2) {
            text-align: right;
        }

        table tr.heading td {
            background: #eee;
            border-bottom: 1px solid #ddd;
            font-weight: bold;
            font-size: 10px;
        }

        .text-capitalize {
            text-transform: capitalize;
        }

        .mb-0 {
            margin-bottom: 0px;
            font-size: 11px;
        }
    </style>
</head>

<body>

    <table cellpadding="0" cellspacing="0">
        <tr class="top_rw">
            <td colspan="2">
                <!-- <h4 style="margin-bottom:0;">Tax invoice/Bill of Supply/Cash memo</h4> -->
                <span>
                    <%= order.created_at %>
                </span>
            </td>

            <td style="width:60%;">
                Order Id: <b>
                    <%= order.order_id %>
                </b><br>
                Order Invoice: <b>
                    <%= order.order_invoice_no %>
                </b><br>
                Payment Mode: <b>
                    <% if (order.payment_method === 'razorpay') { %>
                        ONLINE
                    <% } else if (order.payment_method === 'cod') { %>
                        COD
                    <% } else { %>
                        <%= order.payment_method %>
                    <% } %>
                </b>
            </td>
        </tr>

        <tr class="top">
            <td colspan="3">
                <table>
                    <tr>
                        <td>
                            <b>
                                <%= businessinfo.business_name %>
                            </b><br>
                            <%= businessinfo.business_address1 %><br>
                                <!-- <%= businessinfo.business_address2 %><br> -->
                                <%= businessinfo.business_city %>, <%= businessinfo.business_state %>,
                                        <%= businessinfo.business_country %> - <%= businessinfo.business_pincode %>
                                                <!-- <br> -->

                                                <!-- <% if (businessinfo.business_tax_no) { %>
                                                    GSTIN: <b>
                                                        <%= businessinfo.business_tax_no %>
                                                    </b><br>
                                                    <% } %> -->
                        </td>

                        <td>
                            <img src="<%= logoBase64 %>" style="width:90px;" />
                        </td>
                    </tr>
                </table>
            </td>
        </tr>

        <tr class="information">
            <td colspan="3">
                <table>
                    <tr>
                        <td colspan="2">
                            <b>Shipping Address:</b><br>
                            <h5 class="mb-0 text-capitalize">
                                <%= orderdetail.user_first_name %>
                                    <%= orderdetail.user_last_name %>, <%= orderdetail.user_phone %>
                            </h5>

                            <%= orderdetail.shipping_address %>,<br>
                                <%= orderdetail.shipping_city %> - <%= orderdetail.shipping_pincode %>,<br>
                                        <%= orderdetail.shipping_state %>, <%= orderdetail.shipping_country %><br>
                        </td>

                        <td>
                            <b>Billing Address:</b><br>
                            <h5 class="mb-0 text-capitalize">
                                <%= orderdetail.user_first_name %>
                                    <%= orderdetail.user_last_name %>, <%= orderdetail.user_phone %>
                            </h5>

                            <%= orderdetail.billing_address %>,<br>
                                <%= orderdetail.billing_city %> - <%= orderdetail.billing_pincode %>,<br>
                                        <%= orderdetail.billing_state %>, <%= orderdetail.billing_country %><br>
                        </td>
                    </tr>
                </table>
            </td>
        </tr>

        <!-- ITEMS -->
        <tr>
            <td colspan="3">
                <table cellspacing="0" cellpadding="2">
                    <tr class="heading">
                        <td colspan="2" style="width:30%;">ITEM</td>
                        <td style="width:8%; text-align:center;">QTY.</td>
                        <td style="width:13%; text-align:right;">PRICE</td>
                        <td style="width:23%; text-align:right;">TOTAL</td>
                    </tr>

                    <% orderitems.forEach(item=> { %>
                        <tr class="item">
                            <td colspan="2" class="text-capitalize">
                                <%= item.product_name %>
                            </td>
                            <td style="text-align:center;">
                                <%= item.order_product_quantity %>
                            </td>
                            <td style="text-align:right;">
                                ₹<%= parseFloat(item.offer_price).toFixed(2) %>
                            </td>
                            <td style="text-align:right;">
                                ₹<%= parseFloat(item.order_product_total).toFixed(2) %>
                            </td>
                        </tr>
                        <% }) %>

                            <tr class="item">
                                <td colspan="4" style="text-align:right;"><b>Total</b></td>
                                <td style="text-align:right;">
                                    <b>
                                        ₹<%= parseFloat(totalAmountWithoutTax).toFixed(2) %>
                                    </b>
                                </td>
                            </tr>

                            <% if (ordertax && ordertax.length> 0) { %>
                                <% ordertax.forEach(tax=> { %>
                                    <tr class="item">
                                        <td colspan="4" style="text-align:right;">
                                            <b>Tax (<%= tax.tax_name %>)</b>
                                        </td>
                                        <td style="text-align:right;">
                                            <b>
                                                ₹<%= parseFloat(tax.tax_amount).toFixed(2) %>
                                            </b>
                                        </td>
                                    </tr>
                                    <% }) %>
                                        <% } %>

                                            <tr class="item">
                                                <td colspan="4" style="text-align:right;"><b>Shipping Charges</b></td>
                                                <td style="text-align:right;">
                                                    <b>
                                                        ₹<%= parseFloat(order.order_shipping_charge).toFixed(2) %>
                                                    </b>
                                                </td>
                                            </tr>

                                            <tr class="item">
                                                <td colspan="4" style="text-align:right;"><b>Discount</b></td>
                                                <td style="text-align:right;">
                                                    <b>
                                                        -₹<%= parseFloat(order.order_discount).toFixed(2) %>
                                                    </b>
                                                </td>
                                            </tr>

                                            <tr class="item">
                                                <td colspan="4" style="text-align:right;"><b>Grand Total</b></td>
                                                <td style="text-align:right;">
                                                    <b>
                                                        ₹<%= parseFloat(order.order_grandtotal).toFixed(2) %>
                                                    </b>
                                                </td>
                                            </tr>
                </table>
            </td>
        </tr>

        <tr class="total">
            <td colspan="3" align="right">
                Total Amount in Words:
                <b><span class="text-capitalize">
                        <%= total_in_words %> Only
                    </span></b>
            </td>
        </tr>
        <tr>
            <td colspan="3" align="right">
                <b>Note:</b> Order will be shipped in the next 2-3 working days (Monday to Friday).
            </td>
        </tr>

        <tr>
            <td colspan="3">
                <table>
                    <tr>
                        <td width="50%">
                            <b>Declaration:</b><br>
                            We declare that this invoice shows the actual price of the goods
                            described above and that all particulars are true and correct.
                            Goods are intended for end user consumption and not for resale.
                        </td>

                        <td>
                            * This is a computer-generated invoice and does not require signature
                        </td>
                    </tr>

                    <tr>
                        <td></td>
                        <td>
                            <b>Authorized Signature</b><br>
                            ...................................<br>
                        </td>
                    </tr>
                </table>
            </td>
        </tr>

        <tr>
            <td colspan="3" align="center">
                <p style="font-size:8px;">POWERED BY : RUNR KIDS</p>
            </td>
        </tr>

    </table>

</body>

</html>