<!DOCTYPE html>
<html>

<head>
    <meta charset="utf-8" />
    <title>Invoice Email</title>
    <style>
        .invoice-box {
            max-width: 800px;
            margin: auto;
            padding: 30px;
            border: 1px solid #eee;
            box-shadow: 0 0 10px rgba(0, 0, 0, 0.15);
            font-size: 16px;
            line-height: 24px;
            font-family: 'Helvetica Neue', 'Helvetica', Helvetica, Arial, sans-serif;
            color: #555;
        }

        .invoice-box table {
            width: 100%;
            line-height: inherit;
            text-align: left;
        }

        .invoice-box table td {
            padding: 5px;
            vertical-align: top;
        }

        .invoice-box table tr td:nth-child(2) {
            text-align: right;
        }

        .invoice-box table tr.top table td {
            padding-bottom: 20px;
        }

        .invoice-box table tr.top table td.title {
            font-size: 45px;
            line-height: 45px;
            color: #333;
        }

        .invoice-box table tr.information table td {
            padding-bottom: 40px;
        }

        .invoice-box table tr.heading td {
            background: #eee;
            border-bottom: 1px solid #ddd;
            font-weight: bold;
        }

        .invoice-box table tr.details td {
            padding-bottom: 20px;
        }

        .invoice-box table tr.item td {
            border-bottom: 1px solid #eee;
        }

        .invoice-box table tr.item.last td {
            border-bottom: none;
        }

        .invoice-box table tr.total td:nth-child(2) {
            border-top: 2px solid #eee;
            font-weight: bold;
        }

        @media only screen and (max-width: 600px) {
            .invoice-box {
                padding: 10px;
                font-size: 14px;
            }

            .invoice-box table tr.top table td {
                width: 100%;
                display: block;
                text-align: center;
            }

            .invoice-box table tr.information table td {
                width: 100%;
                display: block;
                text-align: center;
                padding-bottom: 20px;
            }

            /* Stack address columns */
            .invoice-box table tr.information table td:nth-child(2) {
                margin-top: 20px;
            }

            /* Responsive Table for Items */
            .invoice-box table.items-table {
                display: block;
                overflow-x: auto;
                white-space: nowrap;
            }

            .invoice-box table tr.heading td,
            .invoice-box table tr.item td {
                font-size: 12px;
                padding: 5px 2px;
            }
        }

        /** RTL **/
        .invoice-box.rtl {
            direction: rtl;
            font-family: Tahoma, 'Helvetica Neue', 'Helvetica', Helvetica, Arial, sans-serif;
        }

        .invoice-box.rtl table {
            text-align: right;
        }

        .invoice-box.rtl table tr td:nth-child(2) {
            text-align: left;
        }

        .text-capitalize {
            text-transform: capitalize;
        }

        .mb-0 {
            margin-bottom: 0px;
        }
    </style>
</head>

<body>
    <div class="invoice-box">
        <table cellpadding="0" cellspacing="0">
            <tr class="top">
                <td colspan="3">
                    <table>
                        <tr>
                            <!-- <td class="title">
                                <img src="<%= logoBase64 %>" style="width:90px;" />
                            </td> -->
                            <td>
                                <b>Invoice: #<%= orderId %></b><br />
                                Created: <%= orderDate %><br />
                                Payment Mode: <% if (orderPaymentMode === 'razorpay') { %>ONLINE<% } else if (orderPaymentMode === 'cod') { %>COD<% } else { %><%= orderPaymentMode %><% } %>
                            </td>
                        </tr>
                    </table>
                </td>
            </tr>

            <tr class="information">
                <td colspan="3">
                    <table>
                        <tr>
                            <td colspan="2">
                                <b>Shipping Address:</b><br>
                                <h5 class="mb-0 text-capitalize">
                                    <%= orderdetail.user_first_name %>
                                        <%= orderdetail.user_last_name %>, <%= orderdetail.user_phone %>
                                </h5>

                                <%= orderdetail.shipping_address %>,<br>
                                    <%= orderdetail.shipping_city %> - <%= orderdetail.shipping_pincode %>,<br>
                                            <%= orderdetail.shipping_state %>, <%= orderdetail.shipping_country %><br>
                            </td>

                            <td>
                                <b>Billing Address:</b><br>
                                <h5 class="mb-0 text-capitalize">
                                    <%= orderdetail.user_first_name %>
                                        <%= orderdetail.user_last_name %>, <%= orderdetail.user_phone %>
                                </h5>

                                <%= orderdetail.billing_address %>,<br>
                                    <%= orderdetail.billing_city %> - <%= orderdetail.billing_pincode %>,<br>
                                            <%= orderdetail.billing_state %>, <%= orderdetail.billing_country %><br>
                            </td>
                        </tr>
                    </table>
                </td>
            </tr>

            <!-- ITEMS -->
            <tr>
                <td colspan="3">
                    <table cellspacing="0" cellpadding="2">
                        <tr class="heading">
                            <td colspan="2" style="width:30%;">ITEM</td>
                            <td style="width:8%; text-align:center;">QTY.</td>
                            <td style="width:13%; text-align:right;">PRICE</td>
                            <td style="width:23%; text-align:right;">TOTAL</td>
                        </tr>

                        <% orderitems.forEach(item=> { %>
                            <tr class="item">
                                <td colspan="2" class="text-capitalize">
                                    <%= item.product_name %>
                                </td>
                                <td style="text-align:center;">
                                    <%= item.order_product_quantity %>
                                </td>

                                <td style="text-align:right;">
                                    ₹<%= parseFloat(item.offer_price).toFixed(2) %>
                                </td>
                                <td style="text-align:right;">
                                    ₹<%= parseFloat(item.order_product_total).toFixed(2) %>
                                </td>
                            </tr>
                            <% }) %>

                                <tr class="item">
                                    <td colspan="4" style="text-align:right;"><b>Total</b></td>
                                    <td style="text-align:right;">
                                        <b>
                                            ₹<%= parseFloat(totalAmountWithoutTax).toFixed(2) %>
                                        </b>
                                    </td>
                                </tr>

                                <% if (ordertax && ordertax.length> 0) { %>
                                    <% ordertax.forEach(tax=> { %>
                                        <tr class="item">
                                            <td colspan="4" style="text-align:right;">
                                                <b>Tax (<%= tax.tax_name %>)</b>
                                            </td>
                                            <td style="text-align:right;">
                                                <b>
                                                    ₹<%= parseFloat(tax.tax_amount).toFixed(2) %>
                                                </b>
                                            </td>
                                        </tr>
                                        <% }) %>
                                            <% } %>

                                                <tr class="item">
                                                    <td colspan="4" style="text-align:right;"><b>Shipping Charges</b>
                                                    </td>
                                                    <td style="text-align:right;">
                                                        <b>
                                                            ₹<%= parseFloat(order.order_shipping_charge).toFixed(2) %>
                                                        </b>
                                                    </td>
                                                </tr>

                                                <tr class="item">
                                                    <td colspan="4" style="text-align:right;"><b>Discount</b></td>
                                                    <td style="text-align:right;">
                                                        <b>
                                                            -₹<%= parseFloat(order.order_discount).toFixed(2) %>
                                                        </b>
                                                    </td>
                                                </tr>

                                                <tr class="item">
                                                    <td colspan="4" style="text-align:right;"><b>Grand Total</b></td>
                                                    <td style="text-align:right;">
                                                        <b>
                                                            ₹<%= parseFloat(order.order_grandtotal).toFixed(2) %>
                                                        </b>
                                                    </td>
                                                </tr>
                    </table>
                </td>
            </tr>

            <tr class="total">
                <td colspan="3" align="right">
                    Total Amount in Words:
                    <b><span class="text-capitalize">
                            <%= total_in_words %> Only
                        </span></b>
                </td>
            </tr>
            <tr>
                <td colspan="3" align="right">
                    <b>Note:</b> Order will be shipped in the next 2-3 working days (Monday to Friday).
                </td>
            </tr>

            <tr>
                <td colspan="3" align="center">
                    <p style="font-size:8px;">POWERED BY : RUNR KIDS</p>
                </td>
            </tr>
        </table>
    </div>
</body>

</html>