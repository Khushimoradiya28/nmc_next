<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Order Cancelled</title>
    <style>
        .email-container {
            max-width: 600px;
            margin: auto;
            border: 1px solid #eee;
            font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
            color: #555;
            line-height: 24px;
        }
        .content {
            padding: 30px;
            text-align: center;
        }
        .footer {
            background: #f9f9f9;
            padding: 10px;
            text-align: center;
            font-size: 12px;
            color: #999;
        }
        .title {
            font-size: 24px;
            font-weight: bold;
            color: #333;
            margin-bottom: 10px;
        }
        .order-info {
            background-color: #fcebeb;
            border: 1px solid #f5c6c6;
            color: #cc0000;
            padding: 10px;
            margin: 20px 0;
            border-radius: 5px;
            display: inline-block;
        }
        .highlight {
            font-weight: bold;
            color: #333;
        }
    </style>
</head>
<body>
    <div class="email-container">

        <!-- Main Content -->
        <div class="content">
            <div class="title">Order Cancelled</div>
            
            <!-- <p>Dear <span class="highlight"><%= user_first_name || 'Customer' %></span>,</p> -->
            <p>
                Dear 
                <span class="highlight">
                    <%= [user_first_name, user_last_name].filter(Boolean).join(' ') || 'Customer' %>
                </span>,
            </p>
            
            <p>
                This email confirms that your order 
                <span class="highlight">#<%= order_no %></span> 
                has been cancelled successfully, as per your request.
            </p>

            <div class="order-info">
                <strong>Order Status: Cancelled</strong>
            </div>

            <p style="text-align: left; background: #fafafa; padding: 15px; border-radius: 5px; border-left: 4px solid #4CAF50;">
                <strong>Refund Information</strong><br/>
                If payment was completed, the refund has been initiated and will be credited to your original payment method within 
                <strong>5–7 business days</strong>.
            </p>

            <p>
                We appreciate the trust you place in <span class="highlight">RUNR KIDS</span>.  
                Should you need any assistance or wish to shop with us again, our team will be delighted to help.
            </p>

            <p>
                Warm regards,<br/>
                <span class="highlight">RUNR KIDS</span>
            </p>
        </div>

        <!-- Footer -->
        <div class="footer">
            <p>&copy; <%= new Date().getFullYear() %> RUNR KIDS. All rights reserved.</p>
            <p>6th Floor, Swara Park Square, Rupani Circle, Sanskar Mandal Road, Bhavnagar, Gujarat, India</p>
        </div>
    </div>
</body>
</html>
